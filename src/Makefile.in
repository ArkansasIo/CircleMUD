# CircleMUD Makefile.in - Makefile template used by 'configure'
CC = @CC@
CXREF = cxref
MYFLAGS = @MYFLAGS@
PROFILE =
BINDIR = ../bin
CFLAGS = @CFLAGS@ $(MYFLAGS) $(PROFILE)
LIBS = @LIBS@ @CRYPTLIB@ @NETLIB@
RPG_LIBS = -lm

OBJFILES = act.comm.o act.informative.o act.item.o act.movement.o \
	act.offensive.o act.other.o act.social.o act.wizard.o alias.o ban.o \
	boards.o castle.o class.o comm.o config.o constants.o db.o fight.o \
	graph.o handler.o house.o interpreter.o limits.o magic.o mail.o \
	mobact.o modify.o objsave.o olc.o random.o shop.o spec_assign.o \
	spec_procs.o spell_parser.o spells.o utils.o weather.o \
	bsd-snprintf.o aetherworld.o aetherworld_story.o \
	rpg/rpg_level.o rpg/rpg_world_difficulty.o rpg/rpg_encounter.o \
	rpg/rpg_rng.o rpg/rpg_loot.o rpg/rpg_world.o rpg/rpg_system.o \
	rpg/rpg_runtime_tick.o rpg/rpg_heartbeat_hook.o rpg/rpg_circlemud_bridge.o \
	rpg/rpg_circlemud_mob_bridge.o rpg/rpg_circlemud_item_map.o \
	rpg/rpg_circlemud_item_bridge.o rpg/rpg_circlemud_combat_bridge.o \
	rpg/rpg_circlemud_combat_consumer.o rpg/rpg_live.o rpg/rpg_catalog.o \
	rpg/rpg_item.o rpg/rpg_equipment.o rpg/rpg_character.o \
	rpg/rpg_character_value.o rpg/rpg_monster.o rpg/rpg_combat.o \
	rpg/rpg_npc.o rpg/rpg_crafting.o rpg/rpg_loot_drop.o \
	rpg/rpg_ability.o rpg/rpg_skill.o rpg/rpg_quest.o \
	rpg/rpg_quest_runtime.o rpg/rpg_value.o

CXREF_FILES = act.comm.c act.informative.c act.item.c act.movement.c \
	act.offensive.c act.other.c act.social.c act.wizard.c alias.c ban.c \
	boards.c castle.c class.c comm.c config.c constants.c db.c fight.c \
	graph.c handler.c house.c interpreter.c limits.c magic.c mail.c \
	mobact.c modify.c objsave.c olc.c random.c shop.c spec_assign.c \
	spec_procs.c spell_parser.c spells.c utils.c weather.c \
	bsd-snprintf.c aetherworld.c aetherworld_story.c

default: all
all: .accepted
	$(MAKE) $(BINDIR)/circle
	$(MAKE) utils
.accepted:
	@./licheck @MORE@
utils: .accepted
	(cd util; $(MAKE) all)
circle:
	$(MAKE) $(BINDIR)/circle
$(BINDIR)/circle : $(OBJFILES)
	$(CC) -o $(BINDIR)/circle $(PROFILE) $(OBJFILES) $(LIBS) $(RPG_LIBS)
clean:
	rm -f *.o rpg/*.o
ref:
	@for file in $(CXREF_FILES) ; do \
	  echo Cross referencing $$file ; \
	  $(CXREF) -D__CXREF__ -xref -Odoc -Ncircle $$file ; \
	done
	@for file in $(CXREF_FILES) ; do \
	   echo Documenting $$file ; \
	   ( cd . ; $(CXREF) -D__CXREF__ -warn-xref -xref -Odoc -Ncircle -html $$file ) ; \
	   rm -f $(DOCS) ; \
	done
	@echo Indexing
	@( cd . ; $(CXREF) -D__CXREF__ -index-all -Odoc -Ncircle -html )
	@rm -f $(DOCS)
	@echo Creating .h.html files...
	@for file in *.h ; do \
	  echo $$file ; \
	  cat htmlh-head $$file htmlh-tail > doc/$$file.html ; \
	done

rpg/%.o: rpg/%.c
	$(CC) -c $(CFLAGS) -I./rpg $< -o $@
