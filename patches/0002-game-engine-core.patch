From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ArkansasIo <95516724+ArkansasIo@users.noreply.github.com>
Date: Wed, 21 Oct 2026 00:00:00 +0000
Subject: [PATCH] integrate game engine core into CircleMUD build

This patch integrates the dependency-free C game-engine core into the
legacy CircleMUD Makefile. Lua remains an optional scripting layer and is
not linked by this patch, so a stock build does not require liblua.

---
 src/Makefile.in | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/Makefile.in b/src/Makefile.in
--- a/src/Makefile.in
+++ b/src/Makefile.in
@@ -24,7 +24,8 @@ OBJFILES = act.comm.o act.informative.o act.item.o act.movement.o \\
 	mobact.o modify.o objsave.o olc.o random.o shop.o spec_assign.o \\
 	spec_procs.o spell_parser.o spells.o utils.o weather.o \\
-	bsd-snprintf.o
+	bsd-snprintf.o \\
+	game_engine.o game_object.o game_world.o
@@ -211,3 +212,10 @@ weather.o: weather.c conf.h sysdep.h structs.h utils.h comm.h handler.h \\
 	interpreter.h db.h
 	$(CC) -c $(CFLAGS) weather.c
 bsd-snprintf.o: bsd-snprintf.c conf.h sysdep.h
 	$(CC) -c $(CFLAGS) bsd-snprintf.c
+
+game_engine.o: game_engine.c game_engine.h game_types.h game_object.h game_world.h
+	$(CC) -c $(CFLAGS) game_engine.c
+game_object.o: game_object.c game_object.h game_types.h
+	$(CC) -c $(CFLAGS) game_object.c
+game_world.o: game_world.c game_world.h game_types.h
+	$(CC) -c $(CFLAGS) game_world.c
+
+# game_script.o is intentionally excluded until Lua support is enabled.
+# See docs/GAME_ENGINE_UPDATE_NOTES.md for the optional Lua build.
