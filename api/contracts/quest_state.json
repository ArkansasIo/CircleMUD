{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CircleMUD Active Quest State",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "act", "status", "objectives"],
    "properties": {
      "id": {"type": "string"},
      "title": {"type": "string"},
      "act": {"type": "integer", "minimum": 1, "maximum": 12},
      "status": {"type": "string", "enum": ["active", "completed", "failed"]},
      "objectives": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "label", "current", "required"],
          "properties": {
            "id": {"type": "string"},
            "label": {"type": "string"},
            "current": {"type": "integer", "minimum": 0},
            "required": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
