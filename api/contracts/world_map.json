{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CircleMUD World Map",
  "type": "object",
  "required": ["id", "name", "width", "height", "tile_size", "regions", "locations", "player"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "tile_size": {"type": "integer", "minimum": 1},
    "regions": {"type": "array", "items": {"type": "object"}},
    "locations": {"type": "array", "items": {"type": "object"}},
    "roads": {"type": "array", "items": {"type": "array"}},
    "player": {"$ref": "#/$defs/Point"}
  },
  "$defs": {
    "Point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      }
    }
  }
}
